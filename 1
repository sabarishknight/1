print("\n" + "=" * 78 + "\nMODEL COMPARISON\n" + "=" * 78)
comp = pd.DataFrame()
if RESULTS:
    comp = pd.DataFrame(RESULTS).sort_values("Main Score", ascending=False).reset_index(drop=True)
    print(comp.round(4).to_string(index=False))
    if SHOW_PLOTS and len(comp) > 1:
        plt.figure(figsize=(7, .45 * len(comp) + 1.5))
        sns.barplot(data=comp, y="Model", x="Main Score", palette="viridis")
        plt.title(f"Model comparison – {'F1' if task=='classification' else 'R2' if task=='regression' else 'Silhouette'}")
        plt.tight_layout(); plt.show()

    best = comp.loc[0, "Model"]
    bp = FITTED.get(best)

    if task == "classification" and bp is not None:
        pred = bp.predict(Xte)
        print(f"\nClassification report – {best}")
        print(classification_report(yte, pred, target_names=classes, zero_division=0))
        if SHOW_PLOTS:                                   # confusion matrix + ROC of the winner
            fig, ax = plt.subplots(1, 2, figsize=(11, 4))
            ConfusionMatrixDisplay(confusion_matrix(yte, pred), display_labels=classes).plot(ax=ax[0], colorbar=False)
            ax[0].set_title(f"Confusion matrix – {best}")
            try:                                         # ROC needs probabilities
                pr = bp.predict_proba(Xte)
                if pr.shape[1] == 2:
                    fpr, tpr, _ = roc_curve(yte, pr[:, 1])
                    ax[1].plot(fpr, tpr, label=f"AUC={roc_auc_score(yte, pr[:,1]):.3f}")
                    ax[1].plot([0, 1], [0, 1], "--k"); ax[1].set_xlabel("FPR"); ax[1].set_ylabel("TPR")
                    ax[1].set_title("ROC curve"); ax[1].legend()
                else: ax[1].axis("off"); ax[1].set_title("ROC: multiclass -> see ROC_AUC (ovr) in table")
            except Exception: ax[1].axis("off")
            plt.tight_layout(); plt.show()

    if task == "regression" and bp is not None and SHOW_PLOTS:
        pred = bp.predict(Xte); res = yte - pred
        fig, ax = plt.subplots(1, 2, figsize=(11, 4))
        ax[0].scatter(yte, pred, alpha=.6); lim = [min(yte.min(), pred.min()), max(yte.max(), pred.max())]
        ax[0].plot(lim, lim, "--r"); ax[0].set_xlabel("Actual"); ax[0].set_ylabel("Predicted")
        ax[0].set_title(f"Actual vs Predicted – {best}")
        ax[1].scatter(pred, res, alpha=.6); ax[1].axhline(0, ls="--", c="r")
        ax[1].set_xlabel("Predicted"); ax[1].set_ylabel("Residual"); ax[1].set_title("Residual plot")
        plt.tight_layout(); plt.show()

    # feature importance / coefficients of the best model (only if it has them)
    if bp is not None and SHOW_PLOTS and task in ("classification", "regression"):
        try:
            names = bp[:-1].get_feature_names_out()
            est = bp[-1]
            imp = (est.feature_importances_ if hasattr(est, "feature_importances_")
                   else np.abs(np.ravel(est.coef_)) if hasattr(est, "coef_") else None)
            if imp is not None and len(imp) == len(names):
                s = pd.Series(imp, index=names).sort_values(ascending=False)[:15]
                plt.figure(figsize=(6, .35 * len(s) + 1.2)); sns.barplot(x=s.values, y=s.index, palette="mako")
                plt.title(f"Feature importance – {best}"); plt.tight_layout(); plt.show()
        except Exception: pass

