def fit_eval_clf(name, model, Xtr, ytr, Xte, yte, scale=True):
    try:
        p = model if isinstance(model, Pipeline) else pipe(model, scale)
        p.fit(Xtr, ytr); pred = p.predict(Xte)
        proba = p.predict_proba(Xte) if hasattr(p[-1], "predict_proba") else None
        r = {"Model": name,
             "Accuracy":  accuracy_score(yte, pred),
             "Precision": precision_score(yte, pred, average="weighted", zero_division=0),
             "Recall":    recall_score(yte, pred, average="weighted", zero_division=0),
             "F1":        f1_score(yte, pred, average="weighted", zero_division=0),
             "ROC_AUC": np.nan, "LogLoss": np.nan}
        if proba is not None:
            try: r["ROC_AUC"] = (roc_auc_score(yte, proba[:, 1]) if proba.shape[1] == 2
                                 else roc_auc_score(yte, proba, multi_class="ovr", average="weighted"))
            except Exception: pass
            try: r["LogLoss"] = log_loss(yte, proba, labels=list(p[-1].classes_))
            except Exception: pass
        r["Main Score"] = r["F1"]                      # F1 = fair for balanced AND imbalanced data
        RESULTS.append(r); FITTED[name] = p
        auc_txt = f"  auc={r['ROC_AUC']:.3f}" if not np.isnan(r["ROC_AUC"]) else ""
        print(f"  ok  {name:<28} acc={r['Accuracy']:.3f}  f1={r['F1']:.3f}{auc_txt}")
        return p
    except Exception as e:
        FAILED.append((name, str(e)[:120])); print(f"  FAIL {name}: {str(e)[:120]}")

def fit_eval_reg(name, model, Xtr, ytr, Xte, yte, cols=None):
    try:
        global num_cols, cat_cols
        keep_n, keep_c = num_cols, cat_cols
        if cols is not None:                                   # simple LR: one feature only
            num_cols, cat_cols = [c for c in cols if c in keep_n], [c for c in cols if c in keep_c]
        p = pipe(model); p.fit(Xtr, ytr); pred = p.predict(Xte)
        num_cols, cat_cols = keep_n, keep_c
        mse = mean_squared_error(yte, pred)
        r = {"Model": name, "MAE": mean_absolute_error(yte, pred), "MSE": mse,
             "RMSE": np.sqrt(mse), "R2": r2_score(yte, pred)}
        r["Main Score"] = r["R2"]
        RESULTS.append(r); FITTED[name] = p
        print(f"  ok  {name:<28} RMSE={r['RMSE']:.3f}  MAE={r['MAE']:.3f}  R2={r['R2']:.3f}")
        return p
    except Exception as e:
        num_cols, cat_cols = keep_n, keep_c
        FAILED.append((name, str(e)[:120])); print(f"  FAIL {name}: {str(e)[:120]}")

