cat > reducer2.py <<'EOF'
#!/usr/bin/env python
import sys
data = {}
for line in sys.stdin:
    gender, age = line.strip().split(',')
    if gender not in data:
        data[gender] = [0, 0]
    data[gender][0] += float(age)
    data[gender][1] += 1
for gender, values in data.items():
    average = values[0] / values[1]
    print("%s = %s" % (gender, average))
EOF

