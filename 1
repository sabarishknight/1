                    print(f"  k={k:<3} acc={a:.3f}")
                except Exception as e: print(f"  k={k} FAIL {str(e)[:60]}")
            if ks and SHOW_PLOTS:
                plt.figure(figsize=(5, 3)); plt.plot(ks, accs, "o-")
                plt.xlabel("k"); plt.ylabel("test accuracy"); plt.title("KNN: accuracy vs k")
                plt.tight_layout(); plt.show()
                print(f"  best k = {ks[int(np.argmax(accs))]}")

            print("\n--- Sweep: Decision Tree gini vs entropy, depth 2..10/None ---")
            rows = []
            for crit in ("gini", "entropy"):
                for d in [2, 3, 5, 10, None]:
                    try:
                        p = pipe(DecisionTreeClassifier(criterion=crit, max_depth=d,
                                 class_weight=cw, random_state=SEED)).fit(Xtr, ytr)
                        pr = p.predict(Xte)
                        rows.append({"criterion": crit, "max_depth": str(d),
                                     "acc": accuracy_score(yte, pr),
                                     "f1": f1_score(yte, pr, average="weighted", zero_division=0)})
                    except Exception as e: print(f"  {crit}/{d} FAIL {str(e)[:60]}")
            if rows:
                tree_tab = pd.DataFrame(rows); print(tree_tab.to_string(index=False))
                if SHOW_PLOTS:
                    plt.figure(figsize=(6, 3))
                    sns.barplot(data=tree_tab, x="max_depth", y="acc", hue="criterion")
                    plt.title("Decision Tree: depth & criterion"); plt.tight_layout(); plt.show()

            print("\n--- Sweep: SVM kernels ---")
            for kern in ("linear", "rbf", "poly", "sigmoid"):
                try:
                    p = pipe(SVC(kernel=kern, probability=False, class_weight=cw, random_state=SEED)).fit(Xtr, ytr)
                    print(f"  {kern:<8} acc={accuracy_score(yte, p.predict(Xte)):.3f}")
                except Exception as e: print(f"  {kern} FAIL {str(e)[:60]}")

            print("\n--- Sweep: unbalanced vs class_weight='balanced' (Logistic) ---")
            for lbl, w in (("plain", None), ("balanced", "balanced")):
                try:
                    p = pipe(LogisticRegression(max_iter=2000, class_weight=w, random_state=SEED)).fit(Xtr, ytr)
                    pr = p.predict(Xte)
                    print(f"  {lbl:<9} acc={accuracy_score(yte, pr):.3f} "
                          f"recall={recall_score(yte, pr, average='weighted', zero_division=0):.3f} "
                          f"f1={f1_score(yte, pr, average='weighted', zero_division=0):.3f}")
                except Exception as e: print(f"  {lbl} FAIL {str(e)[:60]}")

    else:  # ---------------- regression ----------------
        print("\n--- Baseline ---")
        fit_eval_reg("BASELINE (mean)", DummyRegressor(strategy="mean"), Xtr, ytr, Xte, yte)
        print("--- Models ---")
        want = list(REG_MODELS) if MODELS == "auto" else ([MODELS] if isinstance(MODELS, str) else MODELS)
        best_feat = None
        if num_cols:
            c = Xtr[num_cols].corrwith(ytr).abs().sort_values(ascending=False)
            best_feat = c.index[0] if len(c) else None
        for n in want:
            if n == "linear_simple":
                if best_feat: fit_eval_reg(f"linear_simple ({best_feat})", LinearRegression(),
                                           Xtr, ytr, Xte, yte, cols=[best_feat])
            elif n in REG_MODELS:
                fit_eval_reg(n, REG_MODELS[n](), Xtr, ytr, Xte, yte)

        if RUN_SWEEPS:
            print("\n--- Sweep: Regression tree depth ---")
            for d in [2, 3, 5, 10, None]:
                try:
                    p = pipe(DecisionTreeRegressor(max_depth=d, random_state=SEED)).fit(Xtr, ytr)
                    pr = p.predict(Xte)
                    print(f"  depth={str(d):<5} RMSE={np.sqrt(mean_squared_error(yte, pr)):.3f} R2={r2_score(yte, pr):.3f}")
                except Exception as e: print(f"  depth={d} FAIL {str(e)[:60]}")

