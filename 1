# 8) CLUSTERING  ·  KMeans + elbow + silhouette + PCA  (TASK="clustering")
# =============================================================================
k_best = None
if task == "clustering":
    Xc = make_prep(True).fit_transform(X)                  # scaling matters a lot for KMeans
    ks, inertia, sils = [], [], []
    for k in range(2, min(11, len(X))):                    # elbow + silhouette search
        try:
            km = KMeans(n_clusters=k, random_state=SEED, n_init=10).fit(Xc)
            ks.append(k); inertia.append(km.inertia_); sils.append(silhouette_score(Xc, km.labels_))
            print(f"  k={k:<3} WCSS={km.inertia_:11.2f}  silhouette={sils[-1]:.3f}")
        except Exception as e:
            FAILED.append((f"KMeans k={k}", str(e)[:120])); print(f"  k={k} FAIL {str(e)[:80]}")
    if sils:
        k_best = K_CLUSTERS or ks[int(np.argmax(sils))]    # K_CLUSTERS wins if you set it
        for k, w, s in zip(ks, inertia, sils):
            RESULTS.append({"Model": f"KMeans k={k}" + ("  <= chosen" if k == k_best else ""),
                            "Inertia (WCSS)": w, "Silhouette": s, "Main Score": s})
        km = KMeans(n_clusters=k_best, random_state=SEED, n_init=10).fit(Xc)
        labels = km.labels_
        print(f"\nChosen k = {k_best} | WCSS={km.inertia_:.2f} | silhouette={silhouette_score(Xc, labels):.3f}")
        print("Cluster sizes:"); print(pd.Series(labels).value_counts().sort_index().to_string())
        if SHOW_PLOTS:
            fig, ax = plt.subplots(1, 3, figsize=(14, 3.5))
            ax[0].plot(ks, inertia, "o-"); ax[0].set_title("Elbow method (WCSS)"); ax[0].set_xlabel("k")
            ax[1].plot(ks, sils, "o-"); ax[1].set_title("Silhouette score"); ax[1].set_xlabel("k")
            pc = PCA(n_components=2, random_state=SEED).fit_transform(Xc)
            ax[2].scatter(pc[:, 0], pc[:, 1], c=labels, cmap="viridis", s=18)
            cen = PCA(n_components=2, random_state=SEED).fit(Xc).transform(km.cluster_centers_)
            ax[2].scatter(cen[:, 0], cen[:, 1], c="red", marker="X", s=160)
            ax[2].set_title(f"PCA view of {k_best} clusters")
            plt.tight_layout(); plt.show()
        X_clustered = X.copy(); X_clustered["cluster"] = labels   # <- table with cluster labels
        print("\nCluster means (numeric features):")
        print(X_clustered.groupby("cluster")[num_cols].mean().round(2) if num_cols else "no numeric columns")

# =============================================================================
