# 5) PREPROCESSING PIPELINE  ·  impute + one-hot + scale (fitted on train only)
# =============================================================================
def ohe():
    try:    return OneHotEncoder(handle_unknown="ignore", sparse_output=False)   # sklearn >= 1.2
    except TypeError: return OneHotEncoder(handle_unknown="ignore", sparse=False)

def make_prep(scale=True):
    num = [("imp", SimpleImputer(strategy="median"))] + ([("sc", StandardScaler())] if scale else [])
    return ColumnTransformer(
        [("num", Pipeline(num), num_cols),
         ("cat", Pipeline([("imp", SimpleImputer(strategy="most_frequent")), ("oh", ohe())]), cat_cols)],
        remainder="drop")

def pipe(model, scale=True):
    return Pipeline([("prep", make_prep(scale)), ("model", model)])

def clip_iqr(tr, te):
    """Optional outlier capping: limits come from TRAIN only -> no leakage."""
    if not (CAP_OUTLIERS and num_cols): return tr, te
    q1, q3 = tr[num_cols].quantile(.25), tr[num_cols].quantile(.75); iqr = q3 - q1
    lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr
    tr, te = tr.copy(), te.copy()
    tr[num_cols] = tr[num_cols].clip(lo, hi, axis=1); te[num_cols] = te[num_cols].clip(lo, hi, axis=1)
    print("Outliers clipped to train IQR limits"); return tr, te

