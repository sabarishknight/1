cat > lab3.pig <<'EOF'
A = LOAD 'word1.txt' USING PigStorage(',') AS (id:int, first_name:chararray, last_name:chararray, age:int);
B = FOREACH A GENERATE UPPER(SUBSTRING(first_name, 0, 1)) AS first_letter;
C = GROUP B BY first_letter;
D = FOREACH C GENERATE group AS first_letter, COUNT(B) AS count;
E = ORDER D BY count DESC;
F = LIMIT E 1;
DUMP F;
EOF

