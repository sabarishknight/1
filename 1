# --- loader helpers live here (not in the load cell) so ANY later cell can rebuild `df` ---
def find_file(path):
    """Wrong/typo'd path? Look for the file in ., data/, datasets/, .. instead of crashing."""
    if path is None: return None
    if os.path.exists(path): return path
    pool = [p for d in (".", "data", "datasets", "..") for e in ("csv", "xlsx", "xls")
            for p in glob.glob(os.path.join(d, f"*.{e}"))]
    want = os.path.basename(str(path)).lower()
    hit = [p for p in pool if os.path.basename(p).lower() == want]          # same name, other folder
    hit = hit or [p for p in pool if want.split(".")[0] in os.path.basename(p).lower()]
    if hit:
        print(f"'{path}' not found -> using '{hit[0]}'")
        return hit[0]
    raise FileNotFoundError(f"'{path}' not found. Data files I can see: {pool or 'none'} "
                            f"(working folder = {os.getcwd()}). Fix PATH_1 / PATH_2 in the CONFIG block.")

def load_any(path):
    """Reads .csv/.xlsx/.xls without you having to care which one it is."""
    path = find_file(path)
    if str(path).lower().endswith((".xlsx", ".xls", ".xlsm")):
        return pd.read_excel(path)
    try:
        return pd.read_csv(path, sep=None, engine="python")   # auto-detects , ; | tab
    except Exception:
        return pd.read_csv(path)

def load_data():
    """The whole loading + merging step as one function (uses PATH_1 / PATH_2 / MERGE_KEY)."""
    p1 = find_file(PATH_1)
    d = load_any(p1)
    print(f"File 1: {p1} -> {d.shape}")
    if PATH_2:
        p2 = find_file(PATH_2)
        d2 = load_any(p2)
        print(f"File 2: {p2} -> {d2.shape}")
        common = [c for c in d.columns if c in d2.columns]
        if MERGE_KEY:                                             # explicit join
            d = d.merge(d2, on=MERGE_KEY, how="inner")
            print(f"Merged on {MERGE_KEY} -> {d.shape}")
        elif set(d.columns) == set(d2.columns):                   # same columns -> stack rows
            d = pd.concat([d, d2[d.columns]], ignore_index=True)
            print(f"Same columns -> rows stacked -> {d.shape}")
        elif common:                                              # shared key(s) -> join on them
            d = d.merge(d2, on=common, how="inner")
            print(f"Auto-merged on {common} -> {d.shape}")
        elif len(d) == len(d2):                                   # no shared column, same length -> side by side
            d = pd.concat([d, d2], axis=1)
            print(f"Joined side by side -> {d.shape}")
        else:
            print("Files share nothing -> using file 1 only (set MERGE_KEY if they should be joined)")
    d.columns = [str(c).strip() for c in d.columns]
    return d

